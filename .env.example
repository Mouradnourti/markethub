# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=markethub
POSTGRES_USER=markethub
POSTGRES_PASSWORD=change-me-postgres

# --- Backend ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Shared secret for service-to-service calls (backend <-> ai-service / notification-service)
INTERNAL_API_KEY=change-me-internal-key
# Profiles: "demo" loads the demo seed (users, 120 products, order history) on first start
SPRING_PROFILES_ACTIVE=docker,demo
APP_CURRENCY=eur
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# Encrypts two-factor secrets at rest. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=change-me-data-encryption-key
# Public URL of the storefront, used in e-mail links
STOREFRONT_URL=http://localhost:4200
# Sign-in, sign-up and refresh calls allowed per IP and minute
AUTH_RATE_LIMIT_PER_MINUTE=30

# --- AI service (optional) ---
# With a key, the product description writer uses Claude (claude-opus-5-5); without one, the built-in writer.
ANTHROPIC_API_KEY=

# --- Monitoring (docker compose --profile monitoring up) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Stripe (test mode). Leave empty to use the built-in simulated payment. ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notification service (Laravel) ---
# Generate with: php artisan key:generate --show   (any "base64:" 32-byte key works)
NOTIFICATION_APP_KEY=base64:c2VjcmV0LWtleS1mb3ItZGVtby1vbmx5LTMyLWJ5dGU=
MAIL_FROM_ADDRESS=no-reply@markethub.test
MAIL_FROM_NAME=MarketHub
